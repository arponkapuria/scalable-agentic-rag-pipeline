# --- APP SETTINGS ---
ENV=dev
LOG_LEVEL=INFO
JWT_SECRET_KEY=omnirag-dev-secret-do-not-use-in-production

# --- DATABASE (Postgres, matches docker-compose.yaml) ---
DATABASE_URL=postgresql+asyncpg://omnirag:omnirag_dev_password@localhost:5432/omnirag_db

# --- CACHE (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- VECTOR DB (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=omnirag_collection

# --- AWS / MinIO (S3-API-compatible object storage) ---
# Local dev: these are the MinIO root creds from docker-compose.yaml, not real AWS secrets.
# Cloud demo: swap to real (scoped) AWS creds or Oracle-side equivalent via the host env, not this file.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=omnirag_admin
AWS_SECRET_ACCESS_KEY=omnirag_dev_password
S3_BUCKET_NAME=omnirag-corpus
# None = real AWS. Set for local/demo — same boto3 client code path either way (libs/utils/s3_client.py).
S3_ENDPOINT_URL=http://localhost:9000

# --- LLM BACKEND SELECTION ---
# api = Groq/OpenRouter auto-failover pair (live demo default)
# ollama = local Mac dev, offline, $0 — manual-select only, one live test in Phase 9
# vllm_local = vllm-metal on Mac (3B/4-bit) — manual-select only, one-time demo clip
# vllm_modal = vLLM on Modal GPU — manual-select only, one-time demo clip
LLM_BACKEND=api
# Only relevant when LLM_BACKEND=api. The other of the pair is automatic
# backup on a retryable failure (429/5xx/timeout/connection).
API_PRIMARY=groq

# --- GROQ (primary API backend) ---
GROQ_API_KEY=
# Priority-sorted, comma-separated. First = tried first; on a retryable
# failure the next model in the list is tried before failing over to the
# backup backend (OpenRouter).
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# --- OPENROUTER (backup API backend) ---
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free,nvidia/nemotron-3-ultra-550b-a55b:free,minimax/minimax-m3:free,z-ai/glm-5.2:free,google/gemma-4-31b-it:free,openai/gpt-oss-120b:free

# --- OLLAMA (local Mac dev, offline, $0) ---
# One live test only — Phase 9. Not spun up per-phase.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=llama3.2:3b,qwen2.5:3b

# --- VLLM (manual-select only, never auto-triggered as a failover target) ---
# Local via vllm-metal — 3B/4-bit, one-time demo clip proving the real engine works.
VLLM_METAL_URL=http://localhost:8001
VLLM_METAL_MODELS=Qwen/Qwen2.5-3B-Instruct-AWQ
VLLM_MODAL_URL=
# Sandbox code-exec service. localhost default for local Docker Compose dev (API runs on host, not in Docker) —
# override to the K8s Service DNS name (e.g. http://sandbox-service:8080/execute) for a real cluster deployment.
SANDBOX_URL=http://localhost:8080/execute
VLLM_MODAL_API_KEY=
VLLM_MODAL_MODELS=Qwen/Qwen2.5-7B-Instruct-AWQ,meta-llama/Meta-Llama-3-70B-Instruct-AWQ

# --- EMBEDDINGS + RERANKER ---
# Local primary: FastEmbed (ONNX/CPU, $0). bge-m3 isn't in FastEmbed's
# supported model set — bge-large-en-v1.5 is the closest substitute
# FastEmbed actually ships (see config.py comment).
FASTEMBED_MODEL=BAAI/bge-large-en-v1.5
FASTEMBED_RERANKER_MODEL=BAAI/bge-reranker-base
# Persistent cache dir for FastEmbed's ONNX models — do NOT leave this
# unset. FastEmbed's own default falls back to the system temp dir, which
# macOS (and most Linux tmp-cleanup setups) can wipe between sessions,
# crashing the reranker/embedder mid-request with a "model.onnx" NOT_FOUND
# error (see config.py's comment — this is a known upstream FastEmbed
# issue, not something specific to this project).
FASTEMBED_CACHE_DIR=~/.cache/fastembed
# Fallback on local failure — reuses OPENROUTER_API_KEY above.
OPENROUTER_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# OpenRouter fallback (LLM + reranker) is OFF by default — config-gated,
# not deleted. Flip to true to re-enable Groq<->OpenRouter failover and
# the reranker's OpenRouter backup.
ENABLE_OPENROUTER_FALLBACK=false
RRF_K=60
# RediSearch L2 semantic-match cosine similarity threshold
SEMANTIC_CACHE_THRESHOLD=0.85
# Secondary lexical-overlap gate for L2 cache hits (Phase 6 follow-up) — see redis_cache.py::get_semantic.
SEMANTIC_CACHE_LEXICAL_OVERLAP=0.5
# Length-ratio gate — catches compound-question-vs-its-own-clause cases Jaccard overlap alone cannot. See config.py.
SEMANTIC_CACHE_MIN_LENGTH_RATIO=0.8
RERANK_TOP_N=5
# One Gemini vision call per extracted PDF figure — gated so a broken
# key/rate-limit doesn't fail ingestion, just drops that image's caption.
# Free tier: ~15 RPM / ~1,500 RPD / ~1M TPM (gemini-3.5-flash-lite).
PDF_DESCRIBE_IMAGES=true
GEMINI_API_KEY=
# Web search tool (agents/tools/web_search.py) — free tier at tavily.com,
# no card required. Without this set, web_search gracefully degrades to
# "Web search is disabled (API Key missing)." rather than erroring.
TAVILY_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# --- Docling parsing/chunking ---
# Off by default (born-digital academic PDFs assumed). RapidOCR uses
# ONNXRuntime, not torch, so enabling this doesn't add a torch dependency.
PDF_ENABLE_OCR=false
# accurate|fast — TableFormer has no ONNX path either way, this only
# trades speed for quality.
TABLE_STRUCTURE_MODE=accurate
CHUNK_MAX_TOKENS=512
# Comma-separated picture-classifier labels to skip captioning for
# (saves a Gemini call per skip). Leave empty until you've checked
# logs/ingest_debug/{corpus_id}/docling_pictures.json for real label
# values — don't guess.
PICTURE_SKIP_CLASSES=

# --- HEURISTIC MODEL-TIER ROUTING (responder.py's final-answer call only) ---
ENABLE_MODEL_ROUTING=true
MODEL_TIER_SIMPLE=openai/gpt-oss-20b
MODEL_TIER_COMPLEX=openai/gpt-oss-120b
MODEL_ROUTING_CHAR_THRESHOLD=1500

# --- LOGGING ---
# Rotating JSON file (structured, for tools) + plain console (for you).
LOG_DIR=logs
LOG_FILE_NAME=api.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- INGESTION DEBUG ARTIFACTS ---
# Writes parsed chunks to disk per-corpus so you can inspect quality
# directly. Off before the public demo.
INGEST_DEBUG_DUMP=true
INGEST_DEBUG_DIR=logs/ingest_debug

# --- OBSERVABILITY ---
# Local OTel collector default (Phase 7, `observability` profile only).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- DEMO TUNABLES (rate limiting, retention, cache) ---
# Sole security boundary for a fully open, no-login public demo — enforced at the gateway (Phase 8).
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_HOUR=5
# Inactivity window before a session's corpus (Qdrant points, MinIO objects) is purged (Phase 2).
SESSION_TTL_MINUTES=60
# Historical corpus_version cache entries kept per key, for the before/after comparison feature (Phase 5).
CACHE_VERSIONS_KEPT=2
# Second invalidation axis from corpus_version — tracks CODE/logic changes,
# not data changes. Baked into the cache key (Phase 6): bump this by hand
# after any responder/cache-logic change to instantly orphan every
# previously-cached entry. Deferred: deriving this from the git commit SHA
# automatically instead (needs a build-time hook this project doesn't have yet).
CACHE_SCHEMA_VERSION=1
# Backstop TTL on every cache entry (seconds) — not the primary
# invalidation mechanism (the two above and cascade-delete are). Generous
# on purpose so it never expires a legitimately-fresh entry mid-demo.
CACHE_TTL_SECONDS=86400
