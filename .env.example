# -- App
ENV=dev
LOG_LEVEL=INFO

# -- Database (Postgres)
DATABASE_URL=postgresql+asyncpg://omnirag:omnirag_dev_password@localhost:5432/omnirag_db

# -- Cache / sessions (Redis Stack)
REDIS_URL=redis://localhost:6379/0

# -- Vector DB (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=omnirag_collection

# -- Object storage (S3 / MinIO)
# Local dev: MinIO root creds from docker-compose.yaml, not real AWS secrets.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=omnirag-corpus
# None = real AWS. Set for local/MinIO — same boto3client code path either way.
S3_ENDPOINT_URL=http://localhost:9000

# -- Sandbox (code-exec tool)
# localhost for local Compose dev; override to the service DNS name in a cluster deploy.
SANDBOX_URL=http://localhost:8080/execute

# -- LLM backend selection
# api = Groq/OpenRouter auto-failover pair. ollama/vllm_local/vllm_modal = manual-select only.
LLM_BACKEND=api
# Only relevant when LLM_BACKEND=api. The other of the pair is automatic backup on failure.
API_PRIMARY=groq

# Groq (primary API backend)
GROQ_API_KEY=
# Priority-sorted. First tried first; next model tried before failing over to OpenRouter.
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# OpenRouter (backup API backend)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free,nvidia/nemotron-3-ultra-550b-a55b:free,minimax/minimax-m3:free,z-ai/glm-5.2:free,google/gemma-4-31b-it:free,openai/gpt-oss-120b:free

# Ollama (local, offline, $0)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=llama3.2:3b,qwen2.5:3b

# vLLM (manual-select only, never an auto-failover target)
VLLM_METAL_URL=http://localhost:8001
VLLM_METAL_MODELS=Qwen/Qwen2.5-3B-Instruct-AWQ
VLLM_MODAL_URL=
VLLM_MODAL_API_KEY=
VLLM_MODAL_MODELS=Qwen/Qwen2.5-7B-Instruct-AWQ,meta-llama/Meta-Llama-3-70B-Instruct-AWQ

# -- Embeddings + reranker
# Local, FastEmbed (ONNX/CPU, $0).
FASTEMBED_MODEL=BAAI/bge-large-en-v1.5
FASTEMBED_RERANKER_MODEL=BAAI/bge-reranker-base
# Explicit, persistent — FastEmbed's own default (system temp dir) can get wiped between sessions.
FASTEMBED_CACHE_DIR=~/.cache/fastembed
# Fallback models, reuses OPENROUTER_API_KEY above.
OPENROUTER_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# Off by default. Flip true to enable Groq<->OpenRouter LLM failover + the reranker's OpenRouter backup.
ENABLE_OPENROUTER_FALLBACK=false

# -- Retrieval
RRF_K=60
RERANK_TOP_N=5

# -- Response cache (Redis Stack)
# L2 semantic-match cosine similarity threshold.
SEMANTIC_CACHE_THRESHOLD=0.85
# Secondary lexical-overlap gate for L2 hits — see redis_cache.py::get_semantic.
SEMANTIC_CACHE_LEXICAL_OVERLAP=0.5
# Length-ratio gate — catches a compound question's own narrower sub-clause.
SEMANTIC_CACHE_MIN_LENGTH_RATIO=0.8
# Historical corpus_version entries kept per cache key, for the before/after comparison.
CACHE_VERSIONS_KEPT=2
# Bump to instantly invalidate every cached entry after a code/logic change.
CACHE_SCHEMA_VERSION=1
# Backstop only — corpus_version/CACHE_SCHEMA_VERSION/cascade-delete are the real mechanisms.
CACHE_TTL_SECONDS=86400

# -- Figure captioning (Mistral, ingestion)
PDF_DESCRIBE_IMAGES=true
MISTRAL_API_KEY=
MISTRAL_VISION_MODEL=ministral-14b-2512
# Minimum gap between calls — free plan is 0.5 req/sec, invisible to a per-minute limiter alone.
CAPTION_MIN_INTERVAL_SECONDS=2.0

# -- Ingestion (Docling)
PDF_ENABLE_OCR=false
# accurate|fast — TableFormer has no ONNX path either way; this only trades speed for quality.
TABLE_STRUCTURE_MODE=accurate
CHUNK_MAX_TOKENS=512
# Comma-separated classifier labels to skip captioning for. Check docling_pictures.json before setting.
PICTURE_SKIP_CLASSES=
# Writes parsed chunks to disk per-corpus, for inspecting ingestion quality directly.
INGEST_DEBUG_DUMP=true
INGEST_DEBUG_DIR=logs/ingest_debug

# -- Web search tool (Tavily)
# Free tier, no card required. Unset = web_search reports itself disabled, doesn't error.
TAVILY_API_KEY=

# -- Model-tier routing (responder's final-answer call)
ENABLE_MODEL_ROUTING=true
MODEL_TIER_SIMPLE=openai/gpt-oss-20b
MODEL_TIER_COMPLEX=openai/gpt-oss-120b
MODEL_ROUTING_CHAR_THRESHOLD=1500
ANSWER_MAX_TOKENS=2048

# -- Logging
LOG_DIR=logs
LOG_FILE_NAME=api.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# -- Evaluation judges 
GOOGLE_API_KEY=
GEMMA_JUDGE_MODEL=gemma-4-31b-it
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

COHERE_API_KEY=
COHERE_JUDGE_MODEL=command-r7b-12-2024
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1

# -- Langfuse Cloud (LLM/agent tracing) — observability phase
LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# -- Gateway rate limiting
# Each limit is enforced per session (corpus_id) AND per client IP.
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_HOUR=5
RATE_LIMIT_SESSION_INIT_PER_HOUR=30
FILE_UPLOAD_MAX_SIZE_MB=20

# Inactivity window before a session's corpus is purged and cascade-deleted.
SESSION_TTL_MINUTES=60

# Set true only behind our own reverse proxy that overwrites X-Forwarded-For.
TRUSTED_PROXY=false